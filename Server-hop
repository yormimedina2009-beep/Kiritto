-- ─── Helper para crear instancias ─────────────────────────────
local function create(class, props, children)
    local inst = Instance.new(class)
    for k, v in pairs(props or {}) do
        if k ~= "Parent" then inst[k] = v end
    end
    for _, c in ipairs(children or {}) do
        c.Parent = inst
    end
    if props and props.Parent then inst.Parent = props.Parent end
    return inst
end

local function corner(parent, r)  return create("UICorner", {CornerRadius = UDim.new(0, r or 8), Parent = parent}) end
local function stroke(parent, col, th) return create("UIStroke", {Color = col or C.stroke, Thickness = th or 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = parent}) end
local function gradient(parent, c1, c2, rot)
    return create("UIGradient", {Color = ColorSequence.new(c1, c2), Rotation = rot or 0, Parent = parent})
end

-- ─── Guardado / Lectura de archivos ───────────────────────────
local function leerArchivo(nombre)
    if not (readfile and isfile) then return nil end
    local ok, contenido = pcall(function()
        if isfile(nombre) then return readfile(nombre) end
    end)
    if ok and contenido and #contenido > 0 then return contenido end
    return nil
end

local function escribirArchivo(nombre, contenido)
    if writefile then pcall(function() writefile(nombre, contenido) end) end
end

local function borrarArchivo(nombre)
    if delfile and isfile then pcall(function() if isfile(nombre) then delfile(nombre) end end) end
end

local function leerKeyGuardada() return leerArchivo(KEY_FILE) end
local function guardarKey(k) escribirArchivo(KEY_FILE, k) end
local function borrarKeyGuardada() borrarArchivo(KEY_FILE) end

