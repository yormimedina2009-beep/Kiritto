    local buscando = false
    local cancelar = false

    local function obtenerServidores(placeId)
        local url = "https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?sortOrder=Asc&limit=100"
        local ok, res = pcall(function()
            return HttpService:JSONDecode(game:HttpGet(url))
        end)
        if not ok or not res or not res.data then return nil end
        return res.data
    end

    local function ordenarPorRegion(servidores, regionKey)
        if regionKey == "any" then return servidores end
        local copia = {}
        for _, s in ipairs(servidores) do table.insert(copia, s) end
        table.sort(copia, function(a, b)
            return (a.ping or 9999) < (b.ping or 9999)
        end)
        return copia
    end

    local function teletransportar(jobId)
        local placeId = game.PlaceId
        local player = LocalPlayer

        local ok1 = pcall(function()
            if TeleportService.TeleportAsync then
                TeleportService:TeleportAsync(placeId, {player}, {
                    ServerInstanceId = jobId
                })
            else
                error("no async")
            end
        end)
        if ok1 then return true end

        local ok2 = pcall(function()
            TeleportService:TeleportToPlaceInstance(placeId, jobId, player)
        end)
        if ok2 then return true end

        local ok3 = pcall(function()
            TeleportService:TeleportToPlaceInstance(placeId, jobId)
        end)
        if ok3 then return true end

        return false
    end

    hopBtn.MouseButton1Click:Connect(function()
        if buscando then
            cancelar = true
            return
        end

        buscando = true
        cancelar = false
        hopBtn.Text = "⏹  CANCELAR BÚSQUEDA"
        hopBtn.BackgroundColor3 = C.error
        hopStatus.TextColor3 = C.sub
        hopStatus.Text = "Estado: Buscando servidores..."

        local regionKey = REGIONES[regionActual].key
        local regionNombre = REGIONES[regionActual].nombre

        _G.KirittoNotify("Server Hop", "Buscando · " .. regionNombre, "info")
        playSFX(Sonidos.click, 0.3)

        task.spawn(function()
            local intentos = 0
            local espera = 2
            local maxJugadores = 1
            local SMART_CADA = 5
            local SMART_MAX = 3

            while not cancelar do
                intentos += 1

                if intentos > 1 and intentos % SMART_CADA == 0 and maxJugadores < SMART_MAX then
                    maxJugadores += 1
                    _G.KirittoNotify("Smart Hop", "Ampliando búsqueda a " .. maxJugadores .. " jugadores", "warn")
                end

                hopStatus.Text = string.format(
                    "🔎 Intento #%d · Región: %s · Buscando ≤%d jugador(es)",
                    intentos, regionNombre, maxJugadores
                )

                local servidores = obtenerServidores(game.PlaceId)
                if servidores then
                    local ordenados = ordenarPorRegion(servidores, regionKey)
                    local actual = game.JobId
                    local elegido = nil

                    for _, srv in ipairs(ordenados) do
                        if srv.id ~= actual
                           and srv.playing >= 1
                           and srv.playing <= maxJugadores
                           and srv.playing < srv.maxPlayers then
                            elegido = srv
                            break
                        end
                    end

                    if elegido then
                        hopStatus.TextColor3 = C.success
                        hopStatus.Text = string.format(
                            "✅ Encontrado (%d/%d · ping %dms). Teletransportando...",
                            elegido.playing, elegido.maxPlayers, elegido.ping or 0
                        )
                        hopBtn.Text = "🚀  TELETRANSPORTANDO..."
                        _G.KirittoNotify("¡Encontrado!", elegido.playing .. " jugador(es) · " .. regionNombre, "success")
                        playSFX(Sonidos.exito, 0.4)
                        task.wait(0.7)

                        local exito = teletransportar(elegido.id)

                        if not exito then
                            hopStatus.TextColor3 = C.error
                            hopStatus.Text = "❌ El teletransporte falló. Reintentando con otro servidor..."
                            _G.KirittoNotify("Error de teleport", "Reintentando con otro servidor...", "error")
                            playSFX(Sonidos.error, 0.4)
                            task.wait(1)
                        else
                            buscando = false
                            return
                        end
                    else
                        hopStatus.TextColor3 = C.warn
                        hopStatus.Text = string.format(
                            "🔄 Sin servidores con ≤%d jugador(es) (intento #%d). Reintentando en %ds...",
                            maxJugadores, intentos, espera
                        )
                    end
                else
                    hopStatus.TextColor3 = C.error
                    hopStatus.Text = string.format(
                        "❌ Error al consultar la API (intento #%d). Reintentando en %ds...",
                        intentos, espera
                    )
                end

                local t = 0
                while t < espera and not cancelar do
                    task.wait(0.2)
                    t += 0.2
                end
                espera = math.min(espera + 0.5, 6)
            end

            hopStatus.TextColor3 = C.sub
            hopStatus.Text = "⏹ Búsqueda cancelada por el usuario."
            hopBtn.Text = "🔍  BUSCAR SERVIDOR CON 1 JUGADOR"
            hopBtn.BackgroundColor3 = C.accent
            buscando = false
            _G.KirittoNotify("Cancelado", "Búsqueda detenida.", "warn")
        end)
    end)

